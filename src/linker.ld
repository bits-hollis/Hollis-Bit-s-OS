/* ==============================================================================
   Hollis-Bit's OS — Скрипт компоновщика (Linker Script)
   Размечает секции скомпилированного ядра по физическим адресам оперативной памяти.
   ============================================================================== */

ENTRY(_start)

SECTIONS
{
    /* Базовый адрес ядра: 1 Мегабайт (0x100000). Вся память ниже зарезервирована BIOS/VGA */
    . = 0x100000;

    /* Исполняемый машинный код (выровнен по границе 4 КБ страницы) */
    .text : ALIGN(4K)
    {
        *(.text*)
    }

    /* Константы и строки только для чтения */
    .rodata : ALIGN(4K)
    {
        *(.rodata*)
    }

    /* Инициализированные глобальные переменные */
    .data : ALIGN(4K)
    {
        *(.data*)
    }

    /* Неинициализированная память (заполняется нулями при запуске) */
    .bss : ALIGN(4K)
    {
        *(COMMON)
        *(.bss*)
    }

    /* Метка границы окончания ядра (для последующего распределителя памяти Heap) */
    _kernel_end = .;
}
